# ---- Intent parsing ----
# With a key, Claude reads free-form prompts. Without it, a rules parser handles the common forms.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Venues (all optional; CoW and Jupiter work with no key) ----
ZEROX_API_KEY=            # https://dashboard.0x.org — adds 0x on all EVM chains
ONEINCH_API_KEY=          # https://portal.1inch.dev — adds 1inch on all EVM chains
JUPITER_API_KEY=          # https://portal.jup.ag — higher Solana rate limits (lite API used otherwise)
COINGECKO_API_KEY=        # optional demo key for reference prices

# ---- RPCs (public defaults work; use your own for reliability) ----
RPC_ETHEREUM=
RPC_ARBITRUM=
RPC_BASE=
RPC_OPTIMISM=
RPC_POLYGON=
RPC_SOLANA=
# Browser-side RPCs for wallet reads (same idea, exposed to the client)
NEXT_PUBLIC_RPC_BASE=

# ---- Guardrails (enforced server-side on every plan) ----
INTENT_MAX_SLIPPAGE_BPS=300          # refuse anything above 3%
INTENT_DEFAULT_SLIPPAGE_BPS=50       # 0.5% when the prompt doesn't say
INTENT_MAX_NOTIONAL_USD=10000        # refuse single trades / schedules above this
INTENT_AUTO_CONFIRM_UNDER_USD=0      # web UI always confirms; CLI --yes still honours the caps
INTENT_MAX_PRICE_DEVIATION_BPS=300   # refuse quotes >3% worse than the CoinGecko reference
INTENT_ALLOWED_CHAINS=ethereum,arbitrum,base,optimism,polygon,solana
INTENT_DEFAULT_CHAIN=base            # CLI only; the web UI uses the wallet's chain

# ---- CLI / daemon signing only. The web UI never sees keys: it signs in your wallet. ----
EVM_PRIVATE_KEY=                     # 0x… hex. Use a dedicated hot wallet.
SOLANA_PRIVATE_KEY=                  # base58 secret key. Use a dedicated hot wallet.
